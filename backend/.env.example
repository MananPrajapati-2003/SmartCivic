# SmartCivic — environment variables template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (Neon.tech / Supabase PostgreSQL) ───────────────────────────────
DB_NAME=smartcivic
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST_USER=smart.civicissue@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── SMS ──────────────────────────────────────────────────────────────────────
FAST2SMS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  AI ENGINE  —  Cloud-Offload (no local models needed)
# ─────────────────────────────────────────────────────────────────────────────

# Upstash Redis (Serverless — free tier at https://upstash.com)
# 1. Create a Redis database on Upstash
# 2. Go to "Details" tab → copy the "Redis URL" (starts with rediss://)
# 3. Paste it for BOTH broker and result backend
CELERY_BROKER_URL=rediss://:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST:6380/0
CELERY_RESULT_BACKEND=rediss://:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST:6380/0

# Hugging Face Spaces Inference API
# 1. Train models on Google Colab (see ai_engine/training_data/)
# 2. Deploy .pth weights to a Gradio Space on https://huggingface.co/spaces
# 3. Paste your Space API URLs here
HF_NLP_API_URL=https://YOUR_HF_USERNAME-smartcivic-nlp.hf.space/run/predict_nlp
HF_IMAGE_API_URL=https://YOUR_HF_USERNAME-smartcivic-image.hf.space/run/predict_image

# Hugging Face API token (free — from https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Development helpers ──────────────────────────────────────────────────────
# Set to True to run Celery tasks synchronously (skip Redis) — useful for tests
CELERY_ALWAYS_EAGER=False
